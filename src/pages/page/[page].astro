---
import BlogPost from '../../components/BlogPost.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths({ paginate }) {
  const all = Object.values(import.meta.glob('../../pages/posts/*.md', { eager: true }));

  return paginate(all, { pageSize: 8 });
}

const { page } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout pageTitle={'Page ' + page.currentPage}>
  <ul>
    {
      page.data.map(({ frontmatter, url }) => (
        <BlogPost url={url} title={frontmatter.title} />
      ))
    }
  </ul>

  <p>
    <a href={baseUrl} class="text-sm text-blue-700 font-semibold flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">First</a>
    {
      page.url.prev && page.url.prev > 1 && (
        <a href={page.url.prev} class="text-sm text-blue-700 font-semibold flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">Previous</a>
      )
    }
    {page.url.next && <a href={page.url.next} class="text-sm text-blue-700 font-semibold flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">Next</a>}
  </p>
</BaseLayout>
